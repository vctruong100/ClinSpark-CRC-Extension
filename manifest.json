{
  "manifest_version": 3,
  "name": "ClinSpark CRC Automator",
  "version": "1.0.0",
  "description": "Automation tools for authorized ClinSpark CRC workflows.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ClinSpark CRC Automator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://cenexeltest.clinspark.com/*"
      ],
      "js": [
        "ClinSpark CRC Automator.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://cenexel.clinspark.com/*",
    "https://cenexeltest.clinspark.com/*",
    "https://act-master-schedule.onrender.com/*"
  ],
  "background": {
    "service_worker": "method-library-worker.js"
  }
}
